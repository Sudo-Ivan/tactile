# tactile-publish stack configuration. Copy to .env next to
# docker-compose.yml and edit.

# Public suffix: sites are served at {slug}.SITE_DOMAIN.
SITE_DOMAIN=tactile.localhost

# BASE_DOMAIN overrides SITE_DOMAIN as the publish node's serving suffix.
# Leave unset for subdomain mode. Set it empty (BASE_DOMAIN=) together
# with CADDYFILE=./Caddyfile.path for subpath mode: sites are served at
# SITE_DOMAIN/s/{slug}/, no wildcard DNS or cert needed.
# BASE_DOMAIN=

# Caddyfile selection: ./Caddyfile (subdomain, plain ACME/internal),
# ./Caddyfile.dns (subdomain, DNS-01 wildcard), ./Caddyfile.path (subpath).
# CADDYFILE=./Caddyfile

# Host ports (unprivileged defaults; map 80/443 at your edge or here).
HTTP_PORT=8080
HTTPS_PORT=8443

# TLS issuance:
#   internal            local CA, no inbound needed (default)
#   you@example.com     ACME via HTTP-01/TLS-ALPN-01, needs inbound 80/443
#   off                 plain HTTP behind your own TLS terminator
TLS_CONFIG=internal

# For DNS-01 issuance use CADDYFILE=./Caddyfile.dns and set:
#   CADDYFILE=./Caddyfile.dns
#   ACME_EMAIL=you@example.com
#   DNS_PROVIDER=cloudflare
#   DNS_CREDENTIALS=your-api-token
# Rebuild the caddy image with your provider if not cloudflare:
#   DNS_PLUGINS="github.com/caddy-dns/route53" docker compose build caddy
ACME_EMAIL=
DNS_PROVIDER=cloudflare
DNS_CREDENTIALS=

# publishctl reaches the admin API here (bound to localhost).
ADMIN_PORT=8473

# Node tuning.
POW_BITS=16
MAX_STORAGE=34359738368

# Paid tiers: comma-separated HMAC secrets; mint with publish -mint <tier>.
TOKEN_SECRETS=

# HA mode: S3-compatible backend shared by N stateless replicas.
# BACKEND=s3
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=tactile-publish
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=true
# S3_PREFIX=
# CACHE_DIR=/cache          # local object cache per node
# DNS_RESOLVER=1.1.1.1:53   # resolver for custom-domain TXT checks
