{
  "name": "tactile",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tactile/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@11.24.0",
  "lint-staged": {
    "*.{svelte,js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
