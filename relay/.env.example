# Relay configuration. Copy to .env and edit.
#
# Every command line flag has a TACTILE_RELAY_* environment equivalent:
# uppercase the flag name and replace "-" with "_". An explicitly set
# flag always wins over the environment. Defaults shown below come from
# internal/config/config.go.

# Listen address (flag: -addr)
TACTILE_RELAY_ADDR=:8471

# Blob storage directory (flag: -data)
TACTILE_RELAY_DATA=./relay-data

# Max blob payload bytes (flag: -max-blob-size)
TACTILE_RELAY_MAX_BLOB_SIZE=67108864

# Max websocket message bytes (flag: -max-msg-size)
TACTILE_RELAY_MAX_MSG_SIZE=100663296

# Minimum blob retention (flag: -min-ttl)
TACTILE_RELAY_MIN_TTL=1h

# Maximum blob retention (flag: -max-ttl)
TACTILE_RELAY_MAX_TTL=8760h

# Per-identity stored bytes (flag: -identity-quota)
TACTILE_RELAY_IDENTITY_QUOTA=26843545600

# Total stored bytes across all identities (flag: -max-storage)
TACTILE_RELAY_MAX_STORAGE=1099511627776

# Auth proof-of-work difficulty, 0 disables (flag: -pow-bits)
TACTILE_RELAY_POW_BITS=18

# Auth challenge validity (flag: -challenge-ttl)
TACTILE_RELAY_CHALLENGE_TTL=1m

# Per-connection outbound buffer (flag: -send-queue)
TACTILE_RELAY_SEND_QUEUE=64

# Simultaneous connections per remote IP (flag: -max-conns-per-ip)
TACTILE_RELAY_MAX_CONNS_PER_IP=16

# New connections per second per IP (flag: -conn-rate)
TACTILE_RELAY_CONN_RATE=4

# Messages per second per connection (flag: -msg-rate)
TACTILE_RELAY_MSG_RATE=30

# Global simultaneous connection cap, 0 = unlimited (flag: -max-conns)
TACTILE_RELAY_MAX_CONNS=0

# Expired blob sweep period (flag: -sweep-interval)
TACTILE_RELAY_SWEEP_INTERVAL=1m

# Comma-separated proxy IPs/CIDRs trusted to provide X-Forwarded-For
# (flag: -trusted-proxies)
# TACTILE_RELAY_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.1

# Storage backend: fs or s3 (flag: -backend)
TACTILE_RELAY_BACKEND=fs

# S3 backend settings. When TACTILE_RELAY_S3_BUCKET is set the relay
# stores blobs in S3 instead of the filesystem.
# TACTILE_RELAY_S3_ENDPOINT=https://s3.amazonaws.com
# TACTILE_RELAY_S3_REGION=us-east-1
# TACTILE_RELAY_S3_BUCKET=
# TACTILE_RELAY_S3_ACCESS_KEY=
# TACTILE_RELAY_S3_SECRET_KEY=
# Path-style addressing, required by MinIO/Garage/R2/B2
# TACTILE_RELAY_S3_PATH_STYLE=false
# Key prefix inside the bucket
# TACTILE_RELAY_S3_PREFIX=

# Access control. Sync is public by default; set false to restrict the
# API to allowlisted identities (flag: -allow-public)
# TACTILE_RELAY_ALLOW_PUBLIC=true
# Comma-separated hex Ed25519 public keys allowed when public access is
# off (flag: -allowed-identities)
# TACTILE_RELAY_ALLOWED_IDENTITIES=
# Comma-separated User-Agent prefixes allowed to use the API,
# empty = off (flag: -ua-whitelist)
# TACTILE_RELAY_UA_WHITELIST=
