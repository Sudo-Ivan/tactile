# Homepage configuration. Copy to .env and edit.

# Canonical site URL, used for absolute links in meta tags and the
# sitemap (see src/lib/site.ts). Falls back to the repo URL when unset.
# PUBLIC_SITE_URL=https://example.com

# Where the "Open App" buttons point. Defaults to
# ${PUBLIC_SITE_URL}/app when PUBLIC_SITE_URL is set, otherwise the
# repo URL.
# PUBLIC_APP_URL=https://example.com/app

# Base path when hosting under a subpath (e.g. /tactile on GitHub
# Pages). Read by svelte.config.js as kit.paths.base at build time.
# Leave empty to serve from the domain root.
PUBLIC_BASE_PATH=
