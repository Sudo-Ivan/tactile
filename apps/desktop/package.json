{
	"name": "desktop",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"prepare": "svelte-kit sync",
		"dev:tauri": "tauri dev",
		"tauri": "tauri",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tactile/eslint-config": "workspace:*",
		"@tactile/tailwind-config": "workspace:*",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"eslint": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@internationalized/date": "catalog:",
		"@tactile/core": "workspace:*",
		"@tactile/storage": "workspace:*",
		"@tactile/ui": "workspace:^",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-dialog": "catalog:",
		"@tauri-apps/plugin-fs": "catalog:",
		"@tauri-apps/plugin-os": "catalog:",
		"@tauri-apps/plugin-shell": "catalog:",
		"svelte-sonner": "catalog:"
	}
}
