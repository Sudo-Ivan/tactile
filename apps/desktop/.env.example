# Desktop app configuration. Copy to .env and edit.

# Set automatically by Vite: "development" under `pnpm dev` and
# "production" under `pnpm build`. src/routes/+layout.svelte reads it to
# disable the right-click context menu outside development. There is
# normally no need to set it yourself.
# NODE_ENV=production

# Crash reporting endpoint (Sentry-compatible). Defaults to the hosted
# DSN baked into the app; set to override. Users can disable reporting in
# Settings > General.
# PUBLIC_SENTRY_DSN=
