{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "mobile",
	"description": "Default capability for the mobile app",
	"windows": ["main"],
	"platforms": ["android", "iOS"],
	"permissions": [
		"core:default",
		"fs:default",
		"fs:read-all",
		"fs:write-all",
		{
			"identifier": "fs:scope",
			"allow": ["**"]
		},
		"dialog:default",
		"shell:allow-open",
		"os:default"
	]
}
