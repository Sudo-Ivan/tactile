{
	"$schema": "../node_modules/@tauri-apps/cli/schema.json",
	"productName": "Tactile",
	"version": "0.1.4",
	"identifier": "io.quad4.tactile",
	"build": {
		"beforeBuildCommand": "pnpm build",
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../build"
	},
	"app": {
