# Web app configuration. Copy to .env and edit.

# Base path when hosting the app under a subpath (e.g. /tactile/app on
# GitHub Pages). Read by svelte.config.js as kit.paths.base at build
# time. Leave empty to serve the app from the domain root.
PUBLIC_BASE_PATH=

# Crash reporting endpoint (Sentry-compatible). Defaults to the hosted
# DSN baked into the app; set to override. Users can disable reporting in
# Settings > General.
# PUBLIC_SENTRY_DSN=
