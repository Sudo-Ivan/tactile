		"@tactile/tailwind-config": "workspace:*",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"jsdom": "^30.0.1",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
